# BlueOS LiDAR SLAM Navigation System - environment variable reference.
#
# Copy to `.env` and adjust for your deployment (docker-compose reads this
# automatically; a bare `python -m app.main` needs these exported into the
# shell, e.g. `set -a; source .env; set +a`). All defaults below match the
# hardcoded defaults in app/config.py / app/security.py / app/main.py, so an
# empty .env behaves identically to no .env at all -- this file exists to
# make every override point discoverable in one place (Blind Spot Audit,
# environment-files gap: no such file existed anywhere in the repo despite
# 31 env vars being read across app/config.py, app/security.py, app/main.py).
#
# Full parameter documentation: docs/CONFIGURATION.md. D1-D8 feature-flag
# rationale: TECHNICAL_SPECIFICATION.md.

# ---------------------------------------------------------------------------
# Core / web server
# ---------------------------------------------------------------------------

# DEBUG=true enables verbose app logging. It does NOT by itself enable the
# Werkzeug interactive debugger (see ALLOW_WERKZEUG_DEBUGGER below) -- that
# separation is deliberate, see Blind Spot Audit R3 R3-SEC-1.
DEBUG=false

# The Werkzeug interactive debugger allows arbitrary code execution from any
# client that can trigger an unhandled exception. Refused unless WEB_HOST is
# loopback, regardless of this setting. Leave false in every real deployment.
ALLOW_WERKZEUG_DEBUGGER=false

DATA_DIR=/app/data
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Comma-separated list of allowed CORS origins. A bare `*` is rejected
# (Blind Spot Audit R2 18-11).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://blueos.local

# Require an authenticated token on WebSocket connect, not just REST routes.
REQUIRE_WS_AUTH=false

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# API auth token. If unset, a random token is generated at startup and
# printed to the log (see CLAUDE.md "API Authentication"). Set this for any
# deployment reachable beyond localhost. Rejected if under 16 characters.
LIDAR_API_TOKEN=

# ---------------------------------------------------------------------------
# TFmini-S LiDAR sensor
# ---------------------------------------------------------------------------

LIDAR_PORT=/dev/ttyUSB0

# In-air the TFmini-S spec range is 12m; underwater two-way Beer-Lambert
# absorption makes anything past a few meters guaranteed backscatter/
# multipath, not a real target. 4.0m is a conservative default for
# moderate-clarity water -- tune down for turbid water, up only for bench/
# air testing.
LIDAR_MAX_RANGE_M=4.0

# Refractive index used for the constant-n ToF range correction.
# n_air ~= 1.0003 (effectively 1.0, use for bench/air testing);
# n_water ~= 1.333 (fresh) / 1.339 (sea) at 850nm.
LIDAR_MEDIUM_INDEX=1.333

# ---------------------------------------------------------------------------
# D1: MAVLink 3D attitude fusion (Physics Audit D1) - opt-in
# ---------------------------------------------------------------------------

ENABLE_MAVLINK_3D_ATTITUDE=false
MAVLINK_CONNECTION_STRING=udp:127.0.0.1:14550
MAVLINK_BAUDRATE=115200
MAVLINK_TIMEOUT_S=1.0

# ---------------------------------------------------------------------------
# D2: Multipath / turbidity detection (Physics Audit D2) - opt-in
# ---------------------------------------------------------------------------

ENABLE_MULTIPATH_DETECTION=false
MULTIPATH_WINDOW_SIZE=50
MULTIPATH_MIN_SAMPLES=20
MULTIPATH_SIGNAL_THRESHOLD=100

# ---------------------------------------------------------------------------
# D3/D4: Depth-dependent refractive index + temperature compensation
# (Physics Audit D3/D4) - opt-in
# ---------------------------------------------------------------------------

ENABLE_DEPTH_CORRECTION=false
# Defaults (a=1.333, b=c=0) are a strict no-op over the driver's existing
# constant-n correction until lab/field calibration (calibrate_depth_model())
# provides fitted coefficients for the actual deployment.
DEPTH_REFRACTIVE_A=1.333
DEPTH_REFRACTIVE_B=0.0
DEPTH_REFRACTIVE_C=0.0

ENABLE_TEMPERATURE_CORRECTION=false
TEMPERATURE_REF_C=20.0
TEMPERATURE_SLOPE=0.0005

# ---------------------------------------------------------------------------
# D8: 9-DOF position+attitude EKF fusion (Physics Audit D8) - opt-in
# ---------------------------------------------------------------------------

ENABLE_EKF_FUSION=false
EKF_PROCESS_NOISE_POSITION=0.01
EKF_PROCESS_NOISE_ATTITUDE=0.05
EKF_PROCESS_NOISE_VELOCITY=0.1
EKF_MEASUREMENT_NOISE_POSITION=0.15
EKF_MEASUREMENT_NOISE_ATTITUDE=0.02

# Coarse, uncalibrated smoke-detector for filter divergence (get_health()
# 'ekf_diverged' reason) - covariance_trace above this is reported as
# degraded health. See docs/ALGORITHM_DECISION_LOG.md Decision 4.
EKF_DIVERGENCE_TRACE_THRESHOLD=50.0
