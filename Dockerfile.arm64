# Multi-stage Dockerfile for NVIDIA Orin Nano Super (ARM64)
# Build on x86_64, run on ARM64
#
# Build: docker buildx build --platform linux/arm64 -t blueos-lidar:arm64 -f Dockerfile.arm64 .
# Run: docker run --device /dev/ttyUSB0 -p 5000:5000 blueos-lidar:arm64

# Stage 1: Builder (ARM64 base)
FROM nvcr.io/nvidia/l4t-pytorch:r36.2.0-runtime

LABEL maintainer="BlueOS LiDAR SLAM Team"
LABEL description="BlueOS LiDAR SLAM Navigation System (ARM64)"
LABEL version="1.0"

# Set environment
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    JETPACK_VERSION=6.0 \
    CUDA_HOME=/usr/local/cuda \
    PATH=${CUDA_HOME}/bin:${PATH} \
    LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Install system dependencies (APT)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    git \
    pkg-config \
    # Python development
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    # Linear algebra / scientific computing
    libopenblas-dev \
    liblapack-dev \
    libblas-dev \
    # Image processing
    libjasper-dev \
    libtiff5 \
    libtiff-dev \
    libjasper1 \
    libwebp6 \
    libharfbuzz0b \
    # HDF5 (for data persistence)
    libhdf5-dev \
    # Protocol buffers (for serialization)
    libprotobuf-dev \
    protobuf-compiler \
    # Serial communication
    ser2net \
    # Utilities
    htop \
    iotop \
    screen \
    usbutils \
    curl \
    wget \
    # SSL/crypto
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3.10 -m pip install --upgrade --no-cache-dir \
    pip==24.0 \
    setuptools==69.0.0 \
    wheel==0.42.0

# Install Python scientific stack (ARM64-optimized wheels)
RUN python3.10 -m pip install --no-cache-dir \
    numpy==1.24.3 \
    scipy==1.11.0 \
    scikit-learn==1.3.0 \
    # PyTorch (pre-built for Jetson)
    # Note: Uncomment one of the following based on your Jetson device:
    # torch==2.0.0  # Requires ARM64 wheel from NVIDIA
    # tensorflow==2.13.0  # Alternative to PyTorch

# Install web stack
RUN python3.10 -m pip install --no-cache-dir \
    flask==3.0.0 \
    flask-cors==4.0.0 \
    flask-socketio==5.3.0 \
    python-socketio==5.9.0 \
    python-engineio==4.7.1 \
    # WSGI server (production)
    gunicorn==21.2.0 \
    # WebSocket
    websocket-client==1.6.0

# Install sensor/communication libraries
RUN python3.10 -m pip install --no-cache-dir \
    pyserial==3.5 \
    pymavlink==2.4.40 \
    # Optional: MAVLink over TCP/IP
    mavsdk==1.4.4

# Install testing/development
RUN python3.10 -m pip install --no-cache-dir \
    pytest==7.4.0 \
    pytest-cov==4.1.0 \
    pytest-timeout==2.1.0 \
    mock==5.1.0

# Install Open3D from source (ARM64 doesn't have binary wheel)
# This is time-consuming; consider pre-building or using Docker layer caching
RUN git clone --depth 1 --branch v0.18.0 https://github.com/isl-org/Open3D.git /tmp/Open3D && \
    cd /tmp/Open3D && \
    mkdir -p build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_CUDA_MODULE=OFF \
          -DBUILD_PYBIND11=ON \
          .. && \
    make -j$(nproc) && \
    make install && \
    cd /tmp/Open3D && \
    python3.10 -m pip install --no-cache-dir . && \
    rm -rf /tmp/Open3D

# Install additional ML/inference libraries (optional)
RUN python3.10 -m pip install --no-cache-dir \
    tensorrt \
    onnxruntime

# Create application user (non-root)
RUN useradd -m -s /bin/bash -u 1000 lidar_app

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=lidar_app:lidar_app . /app

# Create data directory with proper permissions
RUN mkdir -p /app/data && \
    chown -R lidar_app:lidar_app /app

# Install application dependencies from requirements.txt
RUN python3.10 -m pip install --no-cache-dir -r requirements.txt

# Create logs directory
RUN mkdir -p /var/log/blsns && \
    chown lidar_app:lidar_app /var/log/blsns

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Drop to non-root user
USER lidar_app

# Expose ports (Dockerfile only supports whole-line comments -- an inline
# comment after EXPOSE is parsed as a port arg and fails the build).
# 5000 = Flask REST API, 8000 = Gunicorn WSGI.
EXPOSE 5000
EXPOSE 8000

# Environment configuration (can be overridden at runtime)
ENV LIDAR_PORT="/dev/ttyUSB0" \
    LIDAR_BAUDRATE="115200" \
    MAVLINK_PORT="/dev/ttyUSB1" \
    DATA_DIR="/app/data" \
    WEB_PORT="5000" \
    LOG_LEVEL="INFO" \
    WORKERS="2" \
    WORKER_THREADS="4"

# Entrypoint: start Flask with Gunicorn
ENTRYPOINT ["python3.10"]
CMD ["-m", "app.main", "--host", "0.0.0.0", "--port", "5000"]

# Alternative CMD for production (with Gunicorn):
# CMD ["gunicorn", \
#      "--bind", "0.0.0.0:8000", \
#      "--workers", "2", \
#      "--worker-class", "sync", \
#      "--timeout", "120", \
#      "--access-logfile", "/var/log/blsns/access.log", \
#      "--error-logfile", "/var/log/blsns/error.log", \
#      "app.wsgi:app"]

# Labels for metadata
LABEL org.opencontainers.image.title="BlueOS LiDAR SLAM Navigation System" \
      org.opencontainers.image.description="Real-time SLAM mapping and underwater ROV navigation" \
      org.opencontainers.image.url="https://github.com/Leonidy431/tfmini_lidar" \
      org.opencontainers.image.documentation="https://github.com/Leonidy431/tfmini_lidar/blob/main/docs/ORIN_NANO_SETUP.md" \
      org.opencontainers.image.vendor="BlueOS Community" \
      org.opencontainers.image.licenses="Proprietary"
